# 复制成 deploy/.env 再改成自己的值：
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# .env 里既有部署参数也有后台凭据，**不要提交到 git**（.gitignore 已经排除它）。
# 这个 .env.example 本身是可以提交的。

# ---------------------------------------------------------------- 站点与证书
# 已经备案并解析到这台服务器的域名，不带 https:// 也不带结尾斜杠
SITE_DOMAIN=example.com
# Let's Encrypt 的通知邮箱（证书快过期时会发信）
ACME_EMAIL=you@example.com

# ------------------------------------------------------------ 仓库与文件属主
# 服务器上仓库的绝对路径。docker-compose.yml 用它做挂载，systemd 单元也读它。
SITE_ROOT=/srv/site
# 仓库属主的 uid/gid。用 `id -u` 和 `id -g` 拿，通常是 1000。
#
# 这一项不能猜：容器里的后台进程以这个身份运行，写出来的 .md / .html
# 属主才和宿主一致。填错的表现是后台能存文章，但宿主上 git status 一片红，
# 或者 git 直接报 "dubious ownership"。
SITE_UID=1000
SITE_GID=1000

# ---------------------------------------------------------------- 后台凭据
# 下面三行由 `node tools/passwd.mjs --out deploy/.env` 生成，不要手写。
# 万一要手工设置：口令哈希用 tools/passwd.mjs，SESSION_SECRET 用
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`。
ADMIN_USER=sean
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# 会话有效期（小时），168 = 7 天
SESSION_TTL_HOURS=168

# ---------------------------------------------------- 自动提交的作者（可选）
# 后台保存文章后会自动 git commit，这两项是那些提交的作者名。
# 不填则用 site-admin / site-admin@localhost。
GIT_AUTHOR_NAME=sean
GIT_AUTHOR_EMAIL=you@example.com

# ------------------------------------------------------------ 备份（可选）
# deploy/backup.sh 用得到；留空就是默认值
BACKUP_DIR=/var/backups/site
BACKUP_KEEP_DAYS=14
