# 写作后台的运行镜像。
#
# 刻意不含 COPY：代码以 bind mount 的形式从宿主仓库挂到 /app，
# 所以更新代码只要 git pull + 重启容器，不需要重新 build。
# 镜像里只装"运行需要的两样东西"：Node 和 git。
#
# git 是必须的 —— 后台保存文章后会自动提交，没装 git 的话
# 保存仍然成功（文件照写、页面照生成），但提交那一步会如实报错。
FROM node:22-alpine

RUN apk add --no-cache git tini

WORKDIR /app
EXPOSE 4322

# tini 当 PID 1：Node 对信号的默认处理不够，没有它的话
# docker compose restart 之后容器里可能留下没被回收的子进程（比如 git）。
ENTRYPOINT ["/sbin/tini", "--", "node", "server/admin.mjs"]

# 用 Node 自己发健康检查请求，不额外装 curl/wget。
# 只走 container 内部回环，不经过 Caddy，所以不需要凭据。
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4322/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
